# Servicio systemd de Despachos-Guias. Copiar a /etc/systemd/system/guias.service y:
#   sudo systemctl daemon-reload && sudo systemctl enable --now guias
#
# Convive con panel-facturadores en la VM "apps", detras del mismo nginx:
# https://apps.calimport.cl/gd/ -> nginx quita el prefijo -> este servicio en :8080.
#
# Mismo criterio que el panel: usuario propio sin privilegios, codigo de root y solo
# lectura para la app, y credenciales en un .env que solo ese usuario puede leer. Si
# alguien vulnera una de las dos aplicaciones, no llega a la otra.

[Unit]
Description=Despachos - guias cedibles firmadas
# Flyway corre las migraciones al arrancar: sin Postgres arriba, no parte.
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=guias
Group=guias
WorkingDirectory=/opt/guias

# Escucha solo en loopback: a internet se sale por nginx, nunca directo al 8080.
# -Xmx512m porque la VM es e2-small y comparte los 2 GB con el panel y con Postgres.
ExecStart=/usr/bin/java -Xmx512m -jar /opt/guias/guias-backend.jar \
    --spring.config.location=/opt/guias/.env \
    --server.address=127.0.0.1 \
    --server.port=8080

Restart=always
RestartSec=10
# Que no reintente para siempre si el fallo es de configuracion: queda visible en
# systemctl status en vez de ciclar en silencio.
StartLimitBurst=5
StartLimitIntervalSec=300

StandardOutput=journal
StandardError=journal
SyslogIdentifier=guias

# Endurecimiento: la app no necesita nada de esto para funcionar.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Lo unico que escribe: las fotos de entrega, que son la evidencia.
ReadWritePaths=/var/lib/guias
UMask=0077

[Install]
WantedBy=multi-user.target
