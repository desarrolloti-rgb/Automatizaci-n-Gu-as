# Plantilla del archivo .env de la VM. Copiar a /opt/guias/.env, completar los valores
# reales, chown guias:guias y chmod 600. NO versionarlo: este ejemplo es el unico que va
# al repo.
#
# La app lo lee con --spring.config.location=/opt/guias/.env: cada clave de aca resuelve
# un ${PLACEHOLDER} de application.properties. Si falta una de las obligatorias, la app
# no arranca y lo dice en el log.
#
# La app vive en https://apps.calimport.cl/gd/, detras del nginx que comparte con el
# Dashboard Logistica. El prefijo /gd lo quita nginx, asi que aca no aparece: el backend
# se sirve como si estuviera en la raiz.

# --- Base de datos (obligatorias) ---
# Postgres en la misma VM, escuchando solo en localhost. Si alguna vez se mueve a
# Cloud SQL, solo cambia esta URL.
DB_URL=jdbc:postgresql://localhost:5432/guias
DB_USER=guias
DB_PASSWORD=

# --- SAP Service Layer (obligatorias) ---
# Misma instalacion que usa Dashboard; su DOCUMENTACION.md tiene los valores vigentes.
SAP_BASE_URL=
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=
# El Service Layer usa certificado autofirmado: en false, la app no puede hablar con SAP.
SAP_TRUST_SELF_SIGNED=true

# --- Sesion (obligatoria) ---
# Minimo 32 caracteres y DISTINTO al de desarrollo. Generar uno nuevo:
#   openssl rand -base64 48
JWT_SECRET=
# Una jornada de reparto (12 h). Vencido el token, el repartidor vuelve a entrar.
JWT_TTL_MINUTES=720

# --- Sesion comun con el Panel de Facturadores (solo jefe de bodega) ---
# Con esto el jefe de bodega entra una vez y queda con sesion en Guias y en el panel por 30
# dias sin uso (cada uso la renueva). Tiene que ser EL MISMO valor que SESION_COMUN_SECRETO
# del .env del panel, y distinto de JWT_SECRET. Generar uno:
#   openssl rand -base64 48
# En la instancia de prueba (/gd-prueba/) dejarlo VACIO: comparte dominio con produccion, y
# con el secreto de produccion aceptaria la sesion de produccion.
SESION_COMUN_SECRETO=
# SESION_COMUN_DIAS=30

# --- Rutas de reparto ---
# Ubicacion de la bodega, de donde sale el repartidor. Sin esto, POST /api/rutas da 503.
RUTAS_ORIGEN_LAT=-33.458472
RUTAS_ORIGEN_LNG=-70.631971
# Por defecto todo es gratuito (OpenStreetMap + optimizador propio + reglas). La politica
# de Nominatim exige un User-Agent que identifique a la aplicacion y a quien la opera.
RUTAS_OSM_USER_AGENT=calimport-guias/1.0 (desarrollo.ti@calimport.cl)
#
# Nominatim busca por coincidencia exacta y las direcciones de SAP no vienen exactas: un
# "AV. VICUNA MACKENA" (por Mackenna) no lo ubica nunca y la guia entra a la ruta ubicada
# solo en su comuna. "cascada" intenta OSM y, SOLO si no encuentra nada, consulta Google.
# Una direccion que OSM ubica aunque sea aproximada no llega a Google, asi que se paga muy
# poco: Geocoding trae 10.000 consultas gratis al mes y cada guia se consulta una sola vez.
#
# Descomentar las dos lineas juntas. Sin la API key, cascada no rompe nada: registra un
# warning y la direccion queda sin ubicar, igual que con OSM solo.
#RUTAS_GEOCODIFICADOR=cascada
#GOOGLE_MAPS_API_KEY=

# --- Sincronizacion desde SAP ---
# Condicion OData extra para separar lo que despacha Calimport de lo que retira el cliente.
# Vacio = trae todas las guias. Se define el martes, con el SAP real a la vista.
GUIAS_SYNC_FILTRO_EXTRA=
# Despachadores externos cuyas guias no se importan (separados por coma). Sin definir =
# SAMEX; definida y vacia = se importan todas. Al encender la integracion con Samex (ver abajo)
# va VACIA: entran todas y bodega marca en la app las que salen por Samex.
# GUIAS_SYNC_TRANSPORTISTAS_EXTERNOS=SAMEX

# --- Transportistas externos (Samex) ---
# Los que bodega puede elegir en la app ("Despacho externo: SAMEX"), en el mismo selector que el
# repartidor. Marcar una guia la deja recibida, y en SAP como T con SAMEX en U_Despachador.
# Sin definir = SAMEX; definida y vacia = no se puede marcar ninguna.
# GUIAS_TRANSPORTISTAS=SAMEX
#
# El lector del portal de Samex (Cloud Run Job samex-sync) entra a /api/integraciones con el ID
# token de Google de su cuenta de servicio: tiene que traer esta audiencia y venir de una de estas
# cuentas (separadas por coma). La audiencia distingue esta instancia de la de prueba
# (https://apps.calimport.cl/gd-prueba) y es la misma que pide el job. Vacias = rechaza todo.
GUIAS_INTEGRACIONES_AUDIENCIA=https://apps.calimport.cl/gd
GUIAS_INTEGRACIONES_CUENTAS=
#
# registrar (defecto): anota lo que dice Samex y su PDF sin tocar la guia (etapa sombra).
# cerrar: ademas deja la guia ENTREGADA con la hora de Samex y le avisa a SAP. Otro valor no
# arranca. Sin correo al cliente para las de Samex.
GUIAS_SAMEX_MODO=registrar

# --- Fotos de entrega ---
# En Cloud Storage: son la evidencia de las entregas y en el disco se perderian con la VM.
# El bucket y la cuenta de servicio de la VM los crea deploy/crear-bucket.ps1.
FOTOS_ALMACEN=gcs
FOTOS_BUCKET=
# Ya no se usa con gcs; queda por las fotos anteriores al cambio (se copian al bucket una vez).
FOTOS_DIRECTORIO=/var/lib/guias/fotos

# --- Respaldo diario ---
# Bucket al que respaldo-guias.sh sube el dump de la base (03:30). Vacio = queda solo en la
# VM, que no sirve si se pierde la maquina. Lo lee el respaldo, no la app.
RESPALDO_BUCKET=

# --- Sincronizacion con SAP ---
# Los UDF de ultima milla (U_EstadoLog, U_Despachador, U_UrlFoto, U_MotivoRech) existen en
# CALIMPORT_PRODUCTIVO. En true la sincronizacion solo trae las guias en P (o sin estado)
# y cada toma, entrega, rechazo y reapertura se escribe en SAP. En false SAP no se entera.
GUIAS_SAP_UDF_ESTADO=true
# U_Dateguia y U_Horaguia: fecha y hora de la entrega. Al 05-11-2026 existen en
# CALIMPORT_TEST pero NO en CALIMPORT_PRODUCTIVO; en true sin que existan, SAP rechaza el
# PATCH completo y ninguna guia vuelve a sincronizar. Pasar a true cuando esten creados.
GUIAS_SAP_UDF_FECHA_ENTREGA=false
# Dominio publico de la app. Se le antepone a la ruta de la foto para que U_UrlFoto quede
# absoluta: quien la mira desde SAP esta fuera de la app y una ruta relativa no le sirve.
GUIAS_URL_PUBLICA=https://apps.calimport.cl/gd
# Cada cuanto se reintenta enviar a SAP lo que quedo sin sincronizar (milisegundos).
GUIAS_SYNC_REINTENTO_MS=120000

# --- Correo de despacho al cliente ---
# Al entregar, el cliente recibe "Despacho entregado" con la foto adjunta, en el correo de su
# ficha de SAP (EmailAddress). Lo envia un proceso aparte, al minuto, y reintenta con espera
# creciente. Por Resend, igual que el Dashboard: la misma API key y el mismo remitente
# verificado (noreply@calimport.cl). Sin SMTP_PASSWORD, con CORREO_DESPACHO=true no arranca.
CORREO_DESPACHO=false
SMTP_PASSWORD=
# Copia oculta interna (separadas por coma) y casilla que recibe si el cliente responde.
# Sin RESPONDER_A, el correo le pide al cliente no responder.
CORREO_DESPACHO_COPIA=
CORREO_DESPACHO_RESPONDER_A=
# PRUEBAS: todo va a esta casilla, no al cliente. En la instancia de prueba (/gd-prueba/) es
# OBLIGATORIA si CORREO_DESPACHO=true: TEST tiene los correos reales de los clientes, y contra
# una base con TEST en el nombre la app no arranca sin ella.
CORREO_DESPACHO_DESVIO=
# CORREO_DESPACHO_MAX_INTENTOS=12

# --- Estaticos ---
# El build de Angular, subido aparte del jar. Compilado con baseHref /gd/ y la API en
# /gd/api (ver environment.prod.ts): ambos tienen que coincidir con el nginx.
STATIC_DIR=file:/opt/guias/static/
