# Plantilla del archivo .env de la VM. Copiar a /opt/guias/.env, completar los valores
# reales, chown guias:guias y chmod 600. NO versionarlo: este ejemplo es el unico que va
# al repo.
#
# La app lo lee con --spring.config.location=/opt/guias/.env: cada clave de aca resuelve
# un ${PLACEHOLDER} de application.properties. Si falta una de las obligatorias, la app
# no arranca y lo dice en el log.
#
# La app vive en https://apps.calimport.cl/gd/, detras del nginx que comparte con el
# Dashboard Logistica. El prefijo /gd lo quita nginx, asi que aca no aparece: el backend
# se sirve como si estuviera en la raiz.

# --- Base de datos (obligatorias) ---
# Postgres en la misma VM, escuchando solo en localhost. Si alguna vez se mueve a
# Cloud SQL, solo cambia esta URL.
DB_URL=jdbc:postgresql://localhost:5432/guias
DB_USER=guias
DB_PASSWORD=

# --- SAP Service Layer (obligatorias) ---
# Misma instalacion que usa Dashboard; su DOCUMENTACION.md tiene los valores vigentes.
SAP_BASE_URL=
SAP_COMPANY_DB=
SAP_USERNAME=
SAP_PASSWORD=
# El Service Layer usa certificado autofirmado: en false, la app no puede hablar con SAP.
SAP_TRUST_SELF_SIGNED=true

# --- Sesion (obligatoria) ---
# Minimo 32 caracteres y DISTINTO al de desarrollo. Generar uno nuevo:
#   openssl rand -base64 48
JWT_SECRET=
# Una jornada. Vencido el token, el repartidor vuelve a entrar.
JWT_TTL_MINUTES=480

# --- Rutas de reparto ---
# Ubicacion de la bodega, de donde sale el repartidor. Sin esto, POST /api/rutas da 503.
RUTAS_ORIGEN_LAT=-33.458472
RUTAS_ORIGEN_LNG=-70.631971
# Por defecto todo es gratuito (OpenStreetMap + optimizador propio + reglas). La politica
# de Nominatim exige un User-Agent que identifique a la aplicacion y a quien la opera.
RUTAS_OSM_USER_AGENT=calimport-guias/1.0 (desarrollo.ti@calimport.cl)
#
# Nominatim busca por coincidencia exacta y las direcciones de SAP no vienen exactas: un
# "AV. VICUNA MACKENA" (por Mackenna) no lo ubica nunca, y una direccion sin ubicar bloquea
# la ruta completa. "cascada" intenta OSM y, SOLO si no encuentra nada, consulta Google.
# Una direccion que OSM ubica aunque sea aproximada no llega a Google, asi que se paga muy
# poco: Geocoding trae 10.000 consultas gratis al mes y cada guia se consulta una sola vez.
#
# Descomentar las dos lineas juntas. Sin la API key, cascada no rompe nada: registra un
# warning y la direccion queda sin ubicar, igual que con OSM solo.
#RUTAS_GEOCODIFICADOR=cascada
#GOOGLE_MAPS_API_KEY=

# --- Sincronizacion desde SAP ---
# Condicion OData extra para separar lo que despacha Calimport de lo que retira el cliente.
# Vacio = trae todas las guias. Se define el martes, con el SAP real a la vista.
GUIAS_SYNC_FILTRO_EXTRA=

# --- Fotos de entrega ---
# Fuera de /opt/guias para que un despliegue nunca las pise por error. Es el unico
# directorio que el servicio puede escribir (ReadWritePaths en guias.service).
FOTOS_DIRECTORIO=/var/lib/guias/fotos

# --- Sincronizacion con SAP ---
# Dominio publico de la app. Se le antepone a la ruta de la foto para que U_UrlFoto quede
# absoluta: quien la mira desde SAP esta fuera de la app y una ruta relativa no le sirve.
GUIAS_URL_PUBLICA=https://apps.calimport.cl/gd
# Cada cuanto se reintenta enviar a SAP lo que quedo sin sincronizar (milisegundos).
GUIAS_SYNC_REINTENTO_MS=120000

# --- Estaticos ---
# El build de Angular, subido aparte del jar. Compilado con baseHref /gd/ y la API en
# /gd/api (ver environment.prod.ts): ambos tienen que coincidir con el nginx.
STATIC_DIR=file:/opt/guias/static/
